meta {
  name: Create Itemized Expense
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/trips/{{tripId}}/expenses/itemized
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

