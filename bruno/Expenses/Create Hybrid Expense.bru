meta {
  name: Create Hybrid Expense
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/trips/{{tripId}}/expenses/hybrid
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

