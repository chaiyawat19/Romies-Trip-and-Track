meta {
  name: Create Trip
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/trips
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

