// Prisma schema file for Romies-Trip-and-Track
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum TripStatus {
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BudgetType {
  TOTAL
  PER_PERSON
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  PREFERRED
}

enum ExpenseCategory {
  FOOD            // ค่ากิน
  FUEL            // ค่าน้ำมัน
  TRANSPORTATION  // ค่ารถ
  ACCOMMODATION   // ค่าที่พัก
  TICKET          // ค่าตั๋ว
  RENTAL          // ค่าเช่าอุปกรณ์
  ENTRANCE_FEE    // ค่าเข้าสถานที่
  TOLLWAY         // ค่าทางด่วน
  SHOPPING        // ค่าของฝาก/ช็อปปิ้ง
  SERVICE         // ค่าบริการ
  COMMON_FUND     // เงินกองกลาง
  ENTERTAINMENT   // บันเทิง
  OTHER           // อื่นๆ
}

enum SplitType {
  EQUAL           // 1. หารเท่ากันทุกคน
  ITEMIZED        // 2. จ่ายตามที่กินจริง (แยกตามรายการอาหาร + VAT + Service Charge ตามสัดส่วน)
  HYBRID          // 3. หารส่วนกลาง + แยกจ่ายส่วนตัว (จานหลักส่วนตัว + กับข้าวตรงกลางหารเท่ากันเฉพาะคนที่ทาน)
  EXACT
  HYBRID_ITEMIZED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

/// ผู้ใช้งานในระบบ
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name                   String?
  avatarUrl              String?   @map("avatar_url")
  password               String?
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpires   DateTime? @map("password_reset_expires")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  memberships         TripMember[]
  availabilities      Availability[]
  createdTodos        TripTodo[]     @relation("CreatedTodos")
  completedTodos      TripTodo[]     @relation("CompletedTodos")
  expensesPaid        Expense[]      @relation("ExpensePayer")
  expenseSplits       ExpenseSplit[]
  settlementsMade     Settlement[]   @relation("SettlementPayer")
  settlementsReceived Settlement[]   @relation("SettlementPayee")

  @@map("users")
}

/// ทริปเที่ยว
model Trip {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(255)
  province        String?     @db.VarChar(100)
  coverImage      String?     @map("cover_image") @db.Text
  startDate       DateTime?   @map("start_date")
  budgetAmount    Decimal?    @map("budget_amount") @db.Decimal(12, 2)
  budgetType      BudgetType? @map("budget_type")
  promptPayNumber String?     @map("promptpay_number") @db.VarChar(50)
  status          TripStatus  @default(PLANNING)
  inviteCode      String      @unique @map("invite_code") @db.VarChar(6)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  members        TripMember[]
  provinces      TripProvince[]
  availabilities Availability[]
  todos          TripTodo[]
  expenses       Expense[]
  settlements    Settlement[]

  @@index([inviteCode], name: "idx_trips_invite_code")
  @@index([status], name: "idx_trips_status")
  @@index([province], name: "idx_trips_province")
  @@map("trips")
}

/// ตารางเชื่อมผู้ใช้กับทริป (สมาชิกทริป)
model TripMember {
  id       String     @id @default(uuid()) @db.Uuid
  tripId   String     @map("trip_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole @default(MEMBER)
  nickname String?    @db.VarChar(100)
  joinedAt DateTime   @default(now()) @map("joined_at")

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId], name: "uk_trip_members_trip_user")
  @@index([tripId], name: "idx_trip_members_trip_id")
  @@index([userId], name: "idx_trip_members_user_id")
  @@map("trip_members")
}

/// วันว่างของแต่ละคน (Calendar Sync / Availability)
model Availability {
  id        String             @id @default(uuid()) @db.Uuid
  tripId    String             @map("trip_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  status    AvailabilityStatus @default(AVAILABLE)
  note      String?            @db.VarChar(255)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId], name: "idx_availabilities_trip_id")
  @@index([userId], name: "idx_availabilities_user_id")
  @@index([startDate, endDate], name: "idx_availabilities_dates")
  @@map("availabilities")
}

/// เช็กลิสต์เป้าหมายทริป (Shared To-Do List)
model TripTodo {
  id            String    @id @default(uuid()) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  createdById   String    @map("created_by_id") @db.Uuid
  sticker       String?   @db.VarChar(100)
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedById String?   @map("completed_by_id") @db.Uuid
  completedAt   DateTime? @map("completed_at")
  orderIndex    Int       @default(0) @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  trip        Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User  @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: Cascade)
  completedBy User? @relation("CompletedTodos", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([tripId], name: "idx_trip_todos_trip_id")
  @@index([tripId, isCompleted], name: "idx_trip_todos_trip_completed")
  @@map("trip_todos")
}

/// บิลค่าใช้จ่ายหลัก (Main Expense)
model Expense {
  id                      String          @id @default(uuid()) @db.Uuid
  tripId                  String          @map("trip_id") @db.Uuid
  paidById                String          @map("paid_by_id") @db.Uuid
  title                   String          @db.VarChar(255)
  totalAmount             Decimal         @map("total_amount") @db.Decimal(12, 2)
  subtotalAmount          Decimal?        @map("subtotal_amount") @db.Decimal(12, 2)
  vatPercentage           Decimal?        @map("vat_percentage") @db.Decimal(5, 2)
  vatAmount               Decimal?        @map("vat_amount") @db.Decimal(12, 2)
  serviceChargePercentage Decimal?        @map("service_charge_percentage") @db.Decimal(5, 2)
  serviceChargeAmount     Decimal?        @map("service_charge_amount") @db.Decimal(12, 2)
  discountAmount          Decimal?        @map("discount_amount") @db.Decimal(12, 2)
  currency                String          @default("THB") @db.VarChar(10)
  category                ExpenseCategory @default(FOOD)
  expenseDate             DateTime        @default(now()) @map("expense_date")
  splitType               SplitType       @default(EQUAL) @map("split_type")
  receiptUrl              String?         @map("receipt_url") @db.Text
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  // Relations
  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  items  ExpenseItem[]
  splits ExpenseSplit[]

  @@index([tripId], name: "idx_expenses_trip_id")
  @@index([paidById], name: "idx_expenses_paid_by_id")
  @@index([expenseDate], name: "idx_expenses_expense_date")
  @@index([category], name: "idx_expenses_category")
  @@map("expenses")
}

/// ก้อนย่อยในบิล เพื่อรองรับ Hybrid Expense Calculator (Expense Items)
model ExpenseItem {
  id        String   @id @default(uuid()) @db.Uuid
  expenseId String   @map("expense_id") @db.Uuid
  name      String   @db.VarChar(255)
  amount    Decimal  @db.Decimal(12, 2)
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int      @default(1)
  isShared  Boolean  @default(false) @map("is_shared")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  expense Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  splits  ExpenseSplit[]

  @@index([expenseId], name: "idx_expense_items_expense_id")
  @@map("expense_items")
}

/// สัดส่วนการหารบิล/ก้อนย่อย (ใครต้องจ่ายก้อนไหนบ้าง)
model ExpenseSplit {
  id        String    @id @default(uuid()) @db.Uuid
  expenseId String    @map("expense_id") @db.Uuid
  itemId    String?   @map("item_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  amount    Decimal   @db.Decimal(12, 2)
  isSettled Boolean   @default(false) @map("is_settled")
  settledAt DateTime? @map("settled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  expense Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  item    ExpenseItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId], name: "idx_expense_splits_expense_id")
  @@index([itemId], name: "idx_expense_splits_item_id")
  @@index([userId], name: "idx_expense_splits_user_id")
  @@index([isSettled], name: "idx_expense_splits_is_settled")
  @@map("expense_splits")
}

/// การเคลียร์เงิน/โอนเงินคืน (Debt Settlement)
model Settlement {
  id        String           @id @default(uuid()) @db.Uuid
  tripId    String           @map("trip_id") @db.Uuid
  payerId   String           @map("payer_id") @db.Uuid
  payeeId   String           @map("payee_id") @db.Uuid
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("THB") @db.VarChar(10)
  proofUrl  String?          @map("proof_url") @db.Text
  status    SettlementStatus @default(PENDING)
  settledAt DateTime?        @map("settled_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Relations
  trip  Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer User @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee User @relation("SettlementPayee", fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([tripId], name: "idx_settlements_trip_id")
  @@index([payerId, payeeId], name: "idx_settlements_payer_payee")
  @@map("settlements")
}

/// ข้อมูลจังหวัดในประเทศไทย (77 จังหวัด)
model Province {
  id     Int    @id @default(autoincrement())
  nameTh String @unique @map("name_th") @db.VarChar(100)
  nameEn String @unique @map("name_en") @db.VarChar(100)
  region String @db.VarChar(50)

  // Relations
  trips TripProvince[]

  @@index([region], name: "idx_provinces_region")
  @@map("provinces")
}

/// ตารางเชื่อมทริปกับจังหวัด (รองรับทริปที่ไปได้หลายจังหวัด พร้อมลำดับการเดินทาง)
model TripProvince {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  provinceId Int      @map("province_id")
  order      Int      @default(0)

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  @@unique([tripId, provinceId], name: "uk_trip_provinces_trip_province")
  @@index([tripId], name: "idx_trip_provinces_trip_id")
  @@index([provinceId], name: "idx_trip_provinces_province_id")
  @@map("trip_provinces")
}

